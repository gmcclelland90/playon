# Reference unit for one native game. Runtime does not enable this template.
# Home forks each game with:
#   systemd-run --user --collect --no-block --unit=playon-server-<name>.service
# so the process lives in the user manager, outside system.slice/playon.service
# (#1038 / #1045). A user scope (`PIDs=`) cannot reliably migrate a PID that
# already sits in the system unit's cgroup.
#
# Install is optional. Kept so hosts can `systemctl cat playon-server@.service`
# and so packaging tests pin the naming.
#
# Never PartOf=playon.service — a control-plane restart must not stop games.
# KillMode=control-group applies only to THIS game unit, so an explicit stop
# still reaps the game tree.
[Unit]
Description=PlayOn native game server %i
Documentation=https://github.com/gmcclelland90/playon/issues/1045
After=network-online.target

[Service]
Type=simple
User=playon
Group=playon
EnvironmentFile=-/etc/playon/playon.env
KillMode=control-group
TimeoutStopSec=90
SuccessExitStatus=0 143
ExecStopPost=-/usr/bin/logger -t playon -- playon_native_unit_stop %n
# ExecStart is supplied by systemd-run --user at runtime.

[Install]
WantedBy=default.target
