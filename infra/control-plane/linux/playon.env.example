PLAYON_ENV=production
PLAYON_HOST=0.0.0.0
# Loopback + fallback port (node-agent). LAN prefers :80 when CAP_NET_BIND_SERVICE is set.
PLAYON_PORT=8787
# PLAYON_LAN_PORT=80
# PLAYON_MDNS=1
PLAYON_ADVERTISE_HOST=192.168.1.50
PLAYON_SESSION_SECRET=replace-with-a-long-random-string
PLAYON_DATA_ROOT=/home/playon/src/playon/apps/api/data
PLAYON_RUNTIME=docker
PLAYON_LLM_MODE=openai_compatible
# PLAYON_HOME_DNS_API_URL=https://playon.games
# PLAYON_VENICE_API_KEY=
# Required to add LAN/cloud nodes (SSH or one-liner). Same value is given to each node-agent.
# Generate: openssl rand -hex 24
PLAYON_NODE_TOKEN=replace-with-a-long-random-string
# PLAYON_BACKUP_ROOT=/mnt/backups/playon
# PLAYON_CORS_ORIGINS=
# PLAYON_WEB_DIST=/home/playon/src/playon/apps/web/dist
