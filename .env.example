PLAYON_DATA_ROOT=./data
PLAYON_PORT=8787

# Bind address. Use 0.0.0.0 for LAN access.
# PLAYON_HOST=0.0.0.0

# development | production — production requires SESSION_SECRET + ADVERTISE_HOST
# PLAYON_ENV=production

# Required in production (encrypts Settings secrets / sessions)
# PLAYON_SESSION_SECRET=generate-a-long-random-string

# LAN IP or hostname shown on player join cards (required in production)
# PLAYON_ADVERTISE_HOST=192.168.1.50

# Extra CORS origins (comma-separated). Same-origin static UI usually needs none.
# PLAYON_CORS_ORIGINS=http://192.168.1.50:5173

# Optional override for Vite build output (default: <repo>/apps/web/dist)
# PLAYON_WEB_DIST=/opt/playon/apps/web/dist

# Real host only: docker (Paper etc.) or native (UT99 etc.).
PLAYON_RUNTIME=docker

# Venice (OpenAI-compatible). API key lives in Settings (encrypted) or:
# PLAYON_VENICE_API_KEY=
PLAYON_LLM_MODE=openai_compatible

PLAYON_API_URL=http://127.0.0.1:8787
PLAYON_NODE_ID=local
# Shared secret for remote node-agent heartbeats (recommended on LAN)
# PLAYON_NODE_TOKEN=change-me
# Off-node / external backup root (USB, NAS mount, second disk)
# PLAYON_BACKUP_ROOT=D:/playon-backups

# SteamCMD for native Steam game installs (Rust, etc.). Linux auto-downloads to ~/steamcmd when missing.
# PLAYON_STEAMCMD=/home/playon/steamcmd/steamcmd.sh
# PLAYON_STEAMCMD_HOME=/home/playon/steamcmd
# PLAYON_STEAMCMD_AUTO=1
