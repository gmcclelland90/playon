{
  "$schema": "https://turbo.build/schema.json",
  "globalPassThroughEnv": [
    "PLAYON_VENICE_API_KEY",
    "VENICE_API_KEY",
    "PLAYON_VENICE_BASE_URL",
    "PLAYON_VENICE_MODEL",
    "PLAYON_LLM_MODE",
    "PLAYON_RUNTIME",
    "PLAYON_SESSION_SECRET",
    "PLAYON_DATA_ROOT",
    "PLAYON_HOST",
    "PLAYON_ENV",
    "PLAYON_ADVERTISE_HOST",
    "PLAYON_CORS_ORIGINS",
    "PLAYON_WEB_DIST",
    "NODE_ENV",
    "CI"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "*.tsbuildinfo"]
    },

    "check": {
      "dependsOn": ["build", "^build"]
    },
    "lint": {
      "dependsOn": ["build", "^build"]
    },
    "test:unit": {
      "dependsOn": ["build", "^build"]
    },
    "test:contract": {
      "dependsOn": ["build", "^build"]
    },
    "test:int": {
      "dependsOn": ["build", "^build"],
      "cache": false
    },
    "test:agent": {
      "dependsOn": ["build", "^build"],
      "cache": false
    },

    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
